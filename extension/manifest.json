{
  "manifest_version": 3,
  "name": "Prism Bookmarks",
  "version": "0.1.0",
  "description": "Save the current page, or any link, into your Prism bookmark drawer with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to Prism bookmarks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "tabs", "storage", "contextMenus"],
  "host_permissions": [],
  "minimum_chrome_version": "120"
}
